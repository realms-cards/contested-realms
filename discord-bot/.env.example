# Discord Bot Configuration
DISCORD_BOT_TOKEN=           # Bot token from Discord Developer Portal
DISCORD_CLIENT_ID=           # Application ID (same as OAuth client ID)
DISCORD_GUILD_ID=            # Your server ID for guild-specific commands

# Realms.cards API
REALMS_API_URL=http://localhost:3001
REALMS_BOT_SECRET=           # Shared secret for bot <-> API auth
REALMS_PUBLIC_URL=           # Browser-reachable site URL for links (defaults to REALMS_API_URL)

# Redis (leader election, guild config, and looking-for-game events from the
# socket server - must be the SAME Redis the socket server uses)
REDIS_URL=redis://localhost:6379

# Socket.IO server
SOCKET_URL=http://localhost:3001

# Logging
LOG_LEVEL=info
