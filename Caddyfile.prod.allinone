{
    email kingofthe@realms.cards
}

turn.realms.cards {
    log {
        output file /var/log/caddy/access.log
        format json
    }

    respond /healthz 200
}

# Frontend (was Vercel). /admin and /api/admin are IP-gated by the Next.js
# middleware via ADMIN_IP_ACCESSLIST; Caddy replaces client-sent
# X-Forwarded-For, so the header it checks cannot be spoofed.
realms.cards {
    log {
        output file /var/log/caddy/access.log
        format json
    }

    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Hashed build assets never change
    @immutable path /_next/static/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    reverse_proxy frontend:3000
}

www.realms.cards {
    redir https://realms.cards{uri} permanent
}

ws.realms.cards {
    log {
        output file /var/log/caddy/access.log
        format json
    }

    # Remove server header but preserve WebSocket upgrade headers
    header {
        -Server
        # CORS for the apex frontend
        Access-Control-Allow-Origin "https://realms.cards"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
        Access-Control-Allow-Credentials false
    }

    @preflight {
        method OPTIONS
        path /socket.io/*
    }
    respond @preflight 204

    # Restrict metrics endpoints by source IP (set METRICS_IP_ALLOWLIST in env for extra CIDRs)
    @metrics {
        path /metrics /metrics.json
    }
    @metrics-allowlist {
        path /metrics /metrics.json
        remote_ip 127.0.0.1/32 {$METRICS_IP_ALLOWLIST}
    }

    route {
        # Allowed metrics (whitelist)
        handle @metrics-allowlist {
            reverse_proxy {
                to server1:3010
                transport http {
                    read_timeout 30s
                    write_timeout 30s
                }
            }
        }
        # Deny non-whitelisted metrics
        handle @metrics {
            respond "forbidden" 403
        }
        # Default: WebSockets reverse proxy to a single Socket.IO server
        handle {
            reverse_proxy {
                to server1:3010
                transport http {
                    read_timeout 3m
                    write_timeout 3m
                }
                health_uri /healthz
                # Explicitly flush responses for WebSocket
                flush_interval -1
            }
        }
    }
}

# Community event calendar — static site generated by the sir-play-a-lot bot
# (~/sir-play-a-lot), served by that container on port 8080, network alias "calendar".
events.realms.cards {
    log {
        output file /var/log/caddy/access.log
        format json
    }
    encode zstd gzip
    header {
        -Server
        # The ICS/JSON feeds are polled by third-party calendar apps.
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    }
    @feeds path /calendar.ics /events.json
    header @feeds Cache-Control "public, max-age=300"
    reverse_proxy calendar:8080
}